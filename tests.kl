include "syntax.kl";
include "helpers/support.kl";
include "parser.kl";

# Compile-time fixtures for the section 1a representation contract.
# These are MiniTS AST values, not parsed or executed MiniTS programs.
# Explicit KLang annotations check constructor payloads and composition.

let primitiveTypes: [Type] = [TNumber, TBoolean, TString, TNull];
let emptyRecordType: Type = TRecord [];
let zeroParameterType: Type = TFunction [] TNumber;
let higherOrderType: Type =
  TFunction
    [ Named "f" (TFunction [Named "x" TNumber] TNumber), 
      Named "x" TNumber
    ]
    TNumber;
let nestedRecordType: Type =
  TRecord
    [ Named "name" TString, 
      Named "profile" (TRecord [Named "active" TBoolean]), 
      Named "next" zeroParameterType
    ];

# Raw syntax retains duplicates so the future checker can reject them.
let duplicateTypeParameterNames: Type =
  TFunction [Named "x" TNumber, Named "x" TString] TNull;
let duplicateTypeFieldNames: Type =
  TRecord [Named "value" TNumber, Named "value" TString];
let duplicateRecordFieldNames: Expr =
  ERecord [Named "value" (ENumber 1.0), Named "value" (EString "second")];

let literals: [Expr] =
  [ENumber 1.5, EBool true, EBool false, EString "MiniTS\n", ENull];
let unaryExpressions: [Expr] =
  [EUnary UNegate (ENumber 1.0), EUnary UNot (EBool false)];
let binaryExpressions: [Expr] =
  [ EBinary BAdd (ENumber 1.0) (ENumber 2.0), 
    EBinary BAdd (EString "Hello, ") (EString "MiniTS"), 
    EBinary BSubtract (ENumber 5.0) (ENumber 2.0), 
    EBinary BMultiply (ENumber 3.0) (ENumber 4.0), 
    EBinary BDivide (ENumber 5.0) (ENumber 2.0), 
    EBinary BLess (ENumber 1.0) (ENumber 2.0), 
    EBinary BLessEqual (ENumber 2.0) (ENumber 2.0), 
    EBinary BGreater (ENumber 3.0) (ENumber 2.0), 
    EBinary BGreaterEqual (ENumber 2.0) (ENumber 2.0), 
    EBinary BStrictEqual (EString "same") (EString "same"), 
    EBinary BStrictNotEqual ENull ENull, 
    EBinary BAnd (EBool true) (EBool false), 
    EBinary BOr (EBool false) (EBool true)
  ];

let leftAssociatedSubtraction: Expr =
  EBinary BSubtract
    (EBinary BSubtract (ENumber 10.0) (ENumber 3.0))
    (ENumber 2.0);

let rightAssociatedAssignment: Expr =
  EAssign "x" (EAssign "y" (ENumber 1.0));

let chainedPostfix: Expr =
  ECall (EField (ECall (EVar "factory") []) "run") [ENumber 1.0];

let orderedArguments: Expr =
  ECall (EVar "pair")
    [EAssign "x" (ENumber 1.0), EAssign "x" (ENumber 2.0)];

let orderedRecordFields: Expr =
  ERecord
    [ 
      Named "first" (EAssign "x" (ENumber 1.0)), 
      Named "second" (EAssign "x" (ENumber 2.0))
    ];

let emptyRecord: Expr = ERecord [];

let emptyProgram: Program = [];
let emptyBlock: Stmt = SBlock [];
let blocksAndControlFlow: Program =
  [ SLet "n" (Some TNumber) (ENumber 0.0), 
    SBlock [SBlock []], 
    SIf (EBool true)
      [SExpr (EAssign "n" (ENumber 1.0))]
      [SExpr (EAssign "n" (ENumber 2.0))], 
      SIf (EBool false) [SBlock []] [], 
      SWhile (EBinary BLess (EVar "n") (ENumber 3.0))
      [SExpr (EAssign "n" (EBinary BAdd (EVar "n") (ENumber 1.0)))], 
      SWhile (EBool false) []
  ];

# The inner initializer retains a reference to x for later scope resolution.
let initializerUsesOuterBinding: Program =
  [ SLet "x" None (ENumber 1.0), 
    SBlock [SLet "x" None (EBinary BAdd (EVar "x") (ENumber 1.0))]
  ];

# Section 1c: factorial with mutable variables and a while block.
let factorialProgram: Program =
  [ SLet "n" (Some TNumber) (ENumber 5.0), 
    SLet "result" None (ENumber 1.0), 
    SWhile (EBinary BGreater (EVar "n") (ENumber 1.0))
      [ SExpr (EAssign "result"
          (EBinary BMultiply (EVar "result") (EVar "n"))), 
        SExpr (EAssign "n"
          (EBinary BSubtract (EVar "n") (ENumber 1.0)))
      ]
  ];

# Section 1c: a zero-argument arrow that will capture counter at runtime.
let counterProgram: Program =
  [ SLet "counter" None (ENumber 0.0), 
      SLet "next" None
      (EArrow [] TNumber
        (EAssign "counter" (EBinary BAdd (EVar "counter") (ENumber 1.0)))), 
    SLet "a" None (ECall (EVar "next") []), 
    SLet "b" None (ECall (EVar "next") [])
  ];

# Section 1c: returning a function requires a nested function annotation.
let makeAdderProgram: Program =
  [ SLet "makeAdder" None
      (EArrow [Named "n" TNumber]
        (TFunction [Named "x" TNumber] TNumber)
        (EArrow [Named "x" TNumber] TNumber
          (EBinary BAdd (EVar "x") (EVar "n")))), 
    SLet "addFive" None (ECall (EVar "makeAdder") [ENumber 5.0]), 
    SLet "result" None (ECall (EVar "addFive") [ENumber 10.0])
  ];

# Section 1c: immutable record construction and field access.
let studentProgram: Program =
  [ SLet "student" None
      (ERecord [Named "name" (EString "Alice"), Named "year" (ENumber 2026.0)]), 
    SLet "name" None (EField (EVar "student") "name"), 
    SLet "nextYear" None
      (EBinary BAdd (EField (EVar "student") "year") (ENumber 1.0))
  ];

# Section 6a: accepting a function and calling it twice.
let higherOrderProgram: Program =
  [ SLet "applyTwice" None
      (EArrow
        [Named "f" (TFunction [Named "x" TNumber] TNumber), Named "x" TNumber]
        TNumber
        (ECall (EVar "f") [ECall (EVar "f") [EVar "x"]])), 
    SLet "increment" None
      (EArrow [Named "n" TNumber] TNumber
        (EBinary BAdd (EVar "n") (ENumber 1.0))), 
    SLet "result" None
      (ECall (EVar "applyTwice") [EVar "increment", ENumber 10.0])
  ];

# Recursion is expressed by assignment after the function variable is declared.
let assignmentRecursionProgram: Program =
  [ SLet "countdown" None (EArrow [Named "n" TNumber] TBoolean (EBool false)), 
    SExpr (EAssign "countdown"
      (EArrow [Named "n" TNumber] TBoolean
        (EBinary BOr
          (EBinary BStrictEqual (EVar "n") (ENumber 0.0))
          (ECall (EVar "countdown")
            [EBinary BSubtract (EVar "n") (ENumber 1.0)])))), 
    SLet "result" None (ECall (EVar "countdown") [ENumber 3.0])
  ];

# Step 1: parser primitives, without combinators or MiniTS grammar rules.
let errorAt (result: Result a ParseError) (expected: Int): Bool =
  match result {
    Err (ParseError offset _) => offset == expected;
    _ => false;
  };

let parserFoundationTests: [Named Bool] =
  [ Named "any character advances cursor"
      (runParser pAnyChar "ab" == Ok (Parsed "a" (ParseState "ab" 1))), 
    Named "any character rejects EOF" (errorAt (runParser pAnyChar "") 0), 
    Named "character matcher rejects EOF" (errorAt (runParser (pChar "a") "") 0), 
    Named "character match from nonzero cursor"
      (pChar "b" (ParseState "ab" 1) == Ok (Parsed "b" (ParseState "ab" 2))), 
    Named "character mismatch reports current offset"
      (errorAt (pChar "x" (ParseState "ab" 1)) 1), 
    Named "character matcher requires one character"
      (errorAt (runParser (pChar "ab") "ab") 0), 
    Named "text match preserves source and advances cursor"
      (runParser (pText "let") "letter" == Ok (Parsed "let" (ParseState "letter" 3))), 
    Named "text mismatch reports first differing position"
      (errorAt (runParser (pText "let") "lex") 2), 
    Named "partial text match reports EOF position"
      (errorAt (runParser (pText "let") "le") 2), 
    Named "empty text consumes nothing"
      (pText "" (ParseState "abc" 1) == Ok (Parsed "" (ParseState "abc" 1))), 
    Named "EOF succeeds at input end"
      (pEof (ParseState "abc" 3) == Ok (Parsed unit (ParseState "abc" 3))), 
    Named "EOF rejects remaining whitespace" (errorAt (runParser pEof " ") 0), 
    Named "failure leaves original input reusable"
      (let input = ParseState "abc" 0 in
       errorAt (pText "ax" input) 1 &&
       pChar "a" input == Ok (Parsed "a" (ParseState "abc" 1))), 
      Named "matched text can be followed by EOF"
      (match runParser (pText "let") "let" {
        Ok (Parsed _ state) => pEof state == Ok (Parsed unit state);
        _ => false;
      })
  ];

let parserCombinatorTests: [Named Bool] =
  [ Named "bind uses the parsed value and updated cursor"
      (runParser (pBind pAnyChar (fn character => pChar character)) "aa!" ==
        Ok (Parsed "a" (ParseState "aa!" 2))),
    Named "sequence reports failure after the first parser"
      (errorAt (runParser (pThen (pChar "a") (pChar "b")) "ax") 1),
    Named "map can change the result type"
      (runParser (pMap str_len (pText "ab")) "abc" == Ok (Parsed 2 (ParseState "abc" 2))),
    Named "then keeps the second value"
      (runParser (pThen (pChar "a") (pChar "b")) "ab" == Ok (Parsed "b" (ParseState "ab" 2))),
    Named "before keeps the first value"
      (runParser (pBefore (pText "ab") pEof) "ab" == Ok (Parsed "ab" (ParseState "ab" 2))),
    Named "alternative restores input after a partial failure"
      (runParser (pOr (pText "abx") (pText "ab")) "aby" == Ok (Parsed "ab" (ParseState "aby" 2))),
    Named "alternative prefers the first success"
      (runParser (pOr (pText "a") (pText "ab")) "ab" == Ok (Parsed "a" (ParseState "ab" 1))),
    Named "alternative retains the furthest error"
      (errorAt (runParser (pOr (pText "abx") (pChar "z")) "aby") 2),
    Named "alternative error ties prefer the first"
      (runParser (pOr (pChar "a") (pChar "b")) "x" == runParser (pChar "a") "x"),
    Named "optional returns a present value"
      (runParser (pOptional (pChar "a")) "ab" == Ok (Parsed (Some "a") (ParseState "ab" 1))),
    Named "optional restores input after a partial failure"
      (runParser (pOptional (pText "ab")) "ax" == Ok (Parsed None (ParseState "ax" 0))),
    Named "many preserves value order and stops at a mismatch"
      (runParser (pMany pAnyChar) "ab" == Ok (Parsed ["a", "b"] (ParseState "ab" 2))),
    Named "many accepts zero matches"
      (runParser (pMany (pChar "a")) "b" == Ok (Parsed [] (ParseState "b" 0))),
    Named "many restores the failed iteration's cursor"
      (runParser (pMany (pText "ab")) "abax" == Ok (Parsed ["ab"] (ParseState "abax" 2))),
    Named "some accepts one or more matches"
      (runParser (pSome (pChar "a")) "aa!" == Ok (Parsed ["a", "a"] (ParseState "aa!" 2))),
    Named "some requires a first match"
      (errorAt (runParser (pSome (pChar "a")) "b") 0),
    Named "many rejects an empty text parser"
      (errorAt (runParser (pMany (pText "")) "abc") 0),
    Named "some rejects a non-consuming pure parser"
      (errorAt (runParser (pSome (pPure "value")) "abc") 0),
    Named "many rejects optional once it stops advancing"
      (errorAt (runParser (pMany (pOptional (pChar "a"))) "a!") 1),
    Named "separated list retains items and leaves the suffix"
      (runParser (pSepBy (pChar "a") (pChar ",")) "a,a!" ==
        Ok (Parsed ["a", "a"] (ParseState "a,a!" 3))),
    Named "separated list permits no items"
      (runParser (pSepBy (pChar "a") (pChar ",")) "" == Ok (Parsed [] (ParseState "" 0))),
    Named "nonempty separated list consumes its complete input"
      (runParser (pBefore (pSepBy1 (pChar "a") (pChar ",")) pEof) "a,a" ==
        Ok (Parsed ["a", "a"] (ParseState "a,a" 3))),
    Named "nonempty separated list requires an item"
      (errorAt (runParser (pSepBy1 (pChar "a") (pChar ",")) "") 0),
    Named "EOF rejects a trailing separator"
      (errorAt (runParser (pBefore (pSepBy (pChar "a") (pChar ",")) pEof) "a,") 1),
    Named "separated list propagates a non-consuming suffix error"
      (errorAt (runParser (pSepBy (pPure "a") (pPure unit)) "") 0),
    Named "nonempty separated list also guards repetition"
      (errorAt (runParser (pSepBy1 (pPure "a") (pPure unit)) "") 0)
  ];

letrec assertParserTests (tests: [Named Bool]): IO Unit =
  match tests {
    [] => pureIO unit;
    (Named label passed) :: rest =>
      if passed then assertParserTests rest
      else do (bindIO) {
        outputLnIO (str_concat "FAIL: " label);
        exit 1
      };
  };

let main: IO Unit = do (bindIO) {
  assertParserTests parserFoundationTests;
  assertParserTests parserCombinatorTests;
  outputLnIO "AST fixtures compiled successfully.";
  outputLnIO "Parser foundation: 14 tests passed.";
  outputLnIO "Parser combinators: 26 tests passed."
};
